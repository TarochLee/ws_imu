Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: imu_link
    Frame Rate: 30

  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 0.5
      Plane: XY
      Plane Cell Count: 20
      Line Style:
        Line Width: 0.03
        Value: Lines
      Alpha: 0.4
      Color: 160; 160; 160

    - Class: rviz_default_plugins/Pose
      Enabled: true
      Name: IMU_Pose
      Topic: /imu/pose
      Shape: Axes
      Axes Length: 0.35
      Axes Radius: 0.03
      Alpha: 1.0

    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: AxesMarkers
      Topic: /imu/axes_markers

    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Frame Timeout: 10
      Show Arrows: false
      Show Axes: false
      Show Names: false
      Update Interval: 0.0

Views:
  Current:
    Class: rviz_default_plugins/Orbit
    Distance: 2.0
    Focal Point: 0; 0; 0
    Pitch: 0.6
    Yaw: 0.6

Window Geometry:
  Height: 900
  Width: 1400
  X: 60
  Y: 60
